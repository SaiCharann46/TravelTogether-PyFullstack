# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
*.egg
.eggs/
lib/
lib64/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles
backend/db.sqlite3

# Environment variables
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node (if ever added)
node_modules/
npm-debug.log

# Temporary files
*.tmp
*.bak

# Migrations (optional: comment out if you want to track them)
# backend/api/migrations/

# Pycache
backend/**/__pycache__/
backend/**/*.pyc
